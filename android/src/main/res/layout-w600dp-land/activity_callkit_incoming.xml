<?xml version="1.0" encoding="utf-8"?>
<!-- Incoming call screen, after the Figma frame "Android Compact - 1".
     Kotlin (CallkitIncomingActivity) looks up every id and view type below by
     name, so renaming or retyping one crashes the screen on inflate. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Blurred avatar over the solid ground (bg/base/default). -->
    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#131414"
        android:scaleType="centerCrop"
        tools:ignore="ContentDescription" />

    <!-- Scrim: bg/base/default at 80%. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC131414" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="false"
        android:orientation="vertical">

        <!-- Kept as a RippleRelativeLayout because Kotlin types it so. The
             ripple is never started and ripple_amount must stay >= 1, since
             the layout divides by it on inflate. -->
        <com.hiennv.flutter_callkit_incoming.widgets.RippleRelativeLayout
            android:id="@+id/llBackgroundAnimation"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fitsSystemWindows="false"
            app:ripple_amount="1"
            app:ripple_color="#00000000">

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:layout_above="@id/ivAvatar"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="20dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_logo"
                android:visibility="invisible"
                tools:ignore="ContentDescription" />

            <!-- Top margin (status bar + 92dp) is set in Kotlin. -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/ivAvatar"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="124dp"
                android:src="@drawable/ic_default_avatar"
                app:civ_border_width="0dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/ivAvatar"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNameCaller"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoSizeMaxTextSize="@dimen/size_text_name"
                    android:autoSizeMinTextSize="12sp"
                    android:autoSizeStepGranularity="2sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="#E1E1E2"
                    android:textSize="@dimen/size_text_name"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="@dimen/size_text_name"
                    app:autoSizeMinTextSize="12sp"
                    app:autoSizeStepGranularity="2sp"
                    app:autoSizeTextType="uniform"
                    tools:ignore="MissingPrefix"
                    tools:targetApi="o"
                    tools:text="Caller Name" />

                <TextView
                    android:id="@+id/tvNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="#939495"
                    android:textSize="16sp"
                    tools:text="Some info" />

            </LinearLayout>

        </com.hiennv.flutter_callkit_incoming.widgets.RippleRelativeLayout>

        <!-- 56dp sides and 16dp bottom, as drawn. The navigation bar inset is a
             margin set in Kotlin, so fitsSystemWindows stays off to avoid
             counting it twice. -->
        <LinearLayout
            android:id="@+id/llAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="0dp"
            android:fitsSystemWindows="false"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="56dp"
            android:paddingEnd="56dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivDeclineCall"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_button_decline"
                    android:padding="12dp"
                    android:src="@drawable/ic_call_screen_decline"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvDecline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/text_decline"
                    android:textColor="#CBCCCD"
                    android:textSize="15sp" />

            </LinearLayout>

            <Space
                android:layout_width="@dimen/base_margin_x5"
                android:layout_height="0dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivAcceptCall"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_button_accept"
                    android:padding="12dp"
                    android:src="@drawable/ic_call_screen_accept"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvAccept"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/text_accept"
                    android:textColor="#CBCCCD"
                    android:textSize="15sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
